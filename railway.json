{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway",
    "watchPatterns": [
      "app/**",
      "main.py",
      "requirements.txt",
      ".python-version",
      "Dockerfile.railway",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "python -B main.py",
    "restartPolicyType": "ALWAYS"
  }
}
