{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "app/**",
      "main.py",
      "requirements.txt",
      ".python-version",
      "Dockerfile",
      "railway.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS"
  }
}
