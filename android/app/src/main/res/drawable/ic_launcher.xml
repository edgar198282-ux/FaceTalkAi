<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#7C3AED" android:centerColor="#4F46E5" android:endColor="#06B6D4" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="oval">
            <solid android:color="#090916" />
            <stroke android:width="3dp" android:color="#D946EF" />
        </shape>
    </item>
</layer-list>
